{
  "name": "maludex-bridge",
  "version": "0.9.2",
  "description": "Local-first iPhone remote bridge for Codex.",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/malulungsoft/maludex.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:control-center": "./scripts/build-control-center-app.sh",
    "doctor": "npm run build --silent && node dist/bridge/src/doctor-cli.js",
    "dev": "tsx bridge/src/index.ts",
    "handoff": "npm run build --silent && node dist/bridge/src/mobile-handoff-cli.js",
    "install:control-center": "./scripts/build-control-center-app.sh --install",
    "rotate-token": "npm run build --silent && node dist/bridge/src/rotate-token.js",
    "release:check": "./scripts/release.sh v$(node -p \"require('./package.json').version\") --check-only",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
